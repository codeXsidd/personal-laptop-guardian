# Supabase (public — safe to embed in agent and mobile app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase (secret — edge function environment only, never in agent or app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Cloud Messaging (secret — edge function environment only)
FCM_SERVER_KEY=your-firebase-server-key

# Windows Agent (set in appsettings.json, not here — listed for reference)
# Agent__SupabaseUrl=https://your-project.supabase.co
# Agent__SupabaseAnonKey=your-anon-key
# Agent__HeartbeatIntervalSeconds=60
# Agent__SyncIntervalSeconds=30
# Agent__SyncBatchSize=50

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- <ApplicationIcon>Assets\shield.ico</ApplicationIcon> -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LaptopGuardian</AssemblyName>
    <RootNamespace>LaptopGuardian.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>Laptop Guardian</AssemblyTitle>
    <Description>Laptop Guardian Windows Desktop Dashboard</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" Condition="Exists('Assets')" />
    <Resource Include="Assets\*.png" Condition="Exists('Assets')" />
  </ItemGroup>

</Project>

<UserControl x:Class="LaptopGuardian.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LaptopGuardian.Desktop.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Heading}"/>

            <!-- Behavior -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Behavior" Style="{StaticResource SubHeading}"/>

                    <CheckBox Content="Minimize to system tray when closed" IsChecked="{Binding MinimizeToTray}" Margin="0,8" FontSize="13"/>
                    <CheckBox Content="Launch on Windows startup" IsChecked="{Binding LaunchOnStartup}" Margin="0,8" FontSize="13"/>
                    <CheckBox Content="Show desktop notifications" IsChecked="{Binding ShowNotifications}" Margin="0,8" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- PIN Lock -->
            <ContentControl Content="{Binding PinSetup}"/>

            <!-- Service Controls -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Service" Style="{StaticResource SubHeading}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Status: " Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ServiceStatus}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServiceStatus}" Value="Running">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ServiceStatus}" Value="Stopped">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ServiceStatus}" Value="Not Installed">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                Command="{Binding RefreshServiceStatusCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Start" Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="12" Margin="0,0,8,0"
                                Command="{Binding StartServiceCommand}" IsEnabled="{Binding IsServiceActionRunning, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Stop" Style="{StaticResource SecondaryButton}" Padding="16,8" FontSize="12" Margin="0,0,8,0"
                                Command="{Binding StopServiceCommand}" IsEnabled="{Binding IsServiceActionRunning, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Restart" Style="{StaticResource SecondaryButton}" Padding="16,8" FontSize="12" Margin="0,0,8,0"
                                Command="{Binding RestartServiceCommand}" IsEnabled="{Binding IsServiceActionRunning, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Services Panel" Style="{StaticResource SecondaryButton}" Padding="16,8" FontSize="12"
                                Command="{Binding OpenServicesPanelCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Closing this desktop app does NOT stop the agent service." FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Service start/stop/restart requires administrator privileges." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Save -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

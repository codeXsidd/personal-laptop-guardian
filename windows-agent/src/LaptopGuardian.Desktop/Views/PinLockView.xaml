<UserControl x:Class="LaptopGuardian.Desktop.Views.PinLockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LaptopGuardian.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PinLockViewModel}"
             Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Section: Branding -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
            <TextBlock Text="&#x1F6E1;" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="Laptop Guardian" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{StaticResource TextPrimaryColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="Enter your PIN to unlock" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{StaticResource TextSecondaryColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
        </StackPanel>

        <!-- Middle Section: PIN Entry -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="400">
            <!-- PIN Dots -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=1}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=2}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=3}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=4}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=5}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=6}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=7}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="16" Height="16" Margin="8" StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                    </Ellipse.Stroke>
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="{Binding Pin.Length, Converter={StaticResource PercentToWidth}, ConverterParameter=8}"/>
                    </Ellipse.Fill>
                </Ellipse>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

            <!-- Number Pad -->
            <UniformGrid Columns="3" Rows="4" Width="280" Height="320">
                <Button Content="1" Command="{Binding AddDigitCommand}" CommandParameter="1" Style="{StaticResource PinButton}"/>
                <Button Content="2" Command="{Binding AddDigitCommand}" CommandParameter="2" Style="{StaticResource PinButton}"/>
                <Button Content="3" Command="{Binding AddDigitCommand}" CommandParameter="3" Style="{StaticResource PinButton}"/>
                <Button Content="4" Command="{Binding AddDigitCommand}" CommandParameter="4" Style="{StaticResource PinButton}"/>
                <Button Content="5" Command="{Binding AddDigitCommand}" CommandParameter="5" Style="{StaticResource PinButton}"/>
                <Button Content="6" Command="{Binding AddDigitCommand}" CommandParameter="6" Style="{StaticResource PinButton}"/>
                <Button Content="7" Command="{Binding AddDigitCommand}" CommandParameter="7" Style="{StaticResource PinButton}"/>
                <Button Content="8" Command="{Binding AddDigitCommand}" CommandParameter="8" Style="{StaticResource PinButton}"/>
                <Button Content="9" Command="{Binding AddDigitCommand}" CommandParameter="9" Style="{StaticResource PinButton}"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource PinActionButton}"/>
                <Button Content="0" Command="{Binding AddDigitCommand}" CommandParameter="0" Style="{StaticResource PinButton}"/>
                <Button Content="⌫" Command="{Binding BackspaceCommand}" Style="{StaticResource PinActionButton}"/>
            </UniformGrid>

            <!-- Unlock Button -->
            <Button Content="Unlock"
                    Command="{Binding UnlockCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="200"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding IsLockedOut, Converter={StaticResource InverseBool}}"/>
        </StackPanel>

        <!-- Bottom spacing -->
        <Border Grid.Row="2"/>
    </Grid>

    <UserControl.Resources>
        <!-- PIN Button Style -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="40" Width="70" Height="70">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PIN Action Button Style -->
        <Style x:Key="PinActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="40" Width="70" Height="70">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>

<UserControl x:Class="LaptopGuardian.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LaptopGuardian.Desktop.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource Heading}"/>

            <!-- Status Banner -->
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding ProtectionStatus}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Service offline"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Text" Value="Agent running"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="  |  " Style="{StaticResource Caption}" Visibility="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Visibility="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Offline"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Text" Value="Online"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding Hostname, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding OsVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Phone Connection Card -->
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock Text="&#x1F4F1;" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Phone Not Paired"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                            <Setter Property="Text" Value="Phone Connected"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Go to Pair Phone to connect your device"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                                <Setter Property="Text" Value="Receiving notifications and activity updates"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Metrics Cards -->
            <TextBlock Text="System Metrics" Style="{StaticResource SubHeading}"/>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <!-- CPU -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,8">
                            <TextBlock.Text>
                                <Binding Path="CpuPercent" StringFormat="{}{0:F0}%"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Grid Height="6">
                            <Border Background="#E8E8E8" CornerRadius="3"/>
                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="3"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding CpuPercent, Converter={StaticResource PercentToScale}}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Memory -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,8">
                            <TextBlock.Text>
                                <Binding Path="MemoryPercent" StringFormat="{}{0:F0}%"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Grid Height="6">
                            <Border Background="#E8E8E8" CornerRadius="3"/>
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding MemoryPercent, Converter={StaticResource PercentToScale}}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Disk -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Disk" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,8">
                            <TextBlock.Text>
                                <Binding Path="DiskPercent" StringFormat="{}{0:F0}%"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Grid Height="6">
                            <Border Background="#E8E8E8" CornerRadius="3"/>
                            <Border Background="{StaticResource WarningBrush}" CornerRadius="3"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding DiskPercent, Converter={StaticResource PercentToScale}}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Battery -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Battery" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,8">
                                <TextBlock.Text>
                                    <Binding Path="BatteryPercent" StringFormat="{}{0:F0}%"/>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding BatteryStatus}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                        </StackPanel>
                        <Grid Height="6">
                            <Border Background="#E8E8E8" CornerRadius="3"/>
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="3"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding BatteryPercent, Converter={StaticResource PercentToScale}}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sync Status -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Sync Status" Style="{StaticResource SubHeading}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pending: " Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding PendingEvents}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="   |   Total: " Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding TotalEvents}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent Activity -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Recent Activity" Style="{StaticResource SubHeading}"/>
                    <ItemsControl ItemsSource="{Binding RecentEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="#F4F4F5">
                                    <DockPanel>
                                        <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SeverityIcon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="400"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No events yet" Visibility="{Binding RecentEvents.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
